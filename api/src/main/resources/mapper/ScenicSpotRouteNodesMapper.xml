<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kmbeast.mapper.ScenicSpotRouteNodesMapper">

    <delete id="removeByRouteItemIds">

        DELETE FROM scenic_spot_route_nodes
        WHERE scenic_spot_route_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator="," index="index">
            #{id}
        </foreach>

    </delete>
</mapper>