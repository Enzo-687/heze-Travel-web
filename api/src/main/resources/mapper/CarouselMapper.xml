<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kmbeast.mapper.CarouselMapper">

    <resultMap id="entityMap" type="com.kmbeast.pojo.vo.CarouselVO">
        <id column="id" property="id"/>
        <result column="scenic_spot_id" property="scenicSpotId"/>
        <result column="cover_url" property="coverUrl"/>
        <result column="title" property="title"/>
        <result column="scenic_spot_title" property="scenicSpotTitle"/>
        <result column="recommend_detail" property="recommendDetail"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

     <select id="listPage" resultMap="entityMap">

        SELECT c.*,ss.title AS scenic_spot_title
        FROM carousel c
         LEFT JOIN  scenic_spot ss ON ss.id = c.scenic_spot_id
        <where>
            <if test="scenicSpotId != null">
                AND c.scenic_spot_id = #{scenicSpotId}
            </if>
            <if test="title != null and title != ''">
                AND c.title LIKE concat('%',#{title},'%')
            </if>
        </where>
        <if test="current != null and size != null">
            LIMIT #{current},#{size}
        </if>

    </select>

    <select id="queryPageCount" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM carousel c
        <where>
            <if test="scenicSpotId != null">
                AND c.scenic_spot_id = #{scenicSpotId}
            </if>
            <if test="title != null and title != ''">
                AND c.title LIKE concat('%',#{title},'%')
            </if>
        </where>
    </select>

</mapper>